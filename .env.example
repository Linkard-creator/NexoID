# NexoID Environment Variables - Configure baseado no seu ambiente

# ============================================
# DATABASE
# ============================================
DATABASE_URL="file:./dev.db"

# ============================================
# AUTHENTICATION
# ============================================
# Para localhost:3000 (desenvolvimento local)
AUTH_URL="http://localhost:3000"

# Para GitHub Codespaces (use o domínio gerado automaticamente)
# AUTH_URL="https://<PORTA>-<CODESPACE_ID>.github.dev"

# Gere um AUTH_SECRET seguro com: openssl rand -base64 32
AUTH_SECRET="[GERAR_COM: openssl rand -base64 32]"

# Email do admin (pode ser qualquer um para desenvolvimento)
ADMIN_EMAIL="seu-email@gmail.com"

# ============================================
# GOOGLE OAUTH (Obtenha em: https://console.cloud.google.com)
# ============================================
# 1. Vá em: https://console.cloud.google.com
# 2. Crie um novo projeto
# 3. Habilite Google+ API
# 4. Vá em "OAuth 2.0 Client IDs"
# 5. Crie uma credencial "Web application"
# 6. URLs autorizadas:
#    - http://localhost:3000/api/auth/callback/google (desenvolvimento local)
#    - https://<PORTA>-<CODESPACE_ID>.github.dev/api/auth/callback/google (Codespaces)
# 7. Copie Client ID e Client Secret abaixo:
AUTH_GOOGLE_ID="[OBTER_DO_CONSOLE_GOOGLE]"
AUTH_GOOGLE_SECRET="[OBTER_DO_CONSOLE_GOOGLE]"

# Public URL para Stripe e frontend
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ============================================
# STRIPE
# ============================================
# Obtenha em: https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# IDs dos produtos/preços Stripe (teste com valores fictícios)
STRIPE_PRODUCT_ID_NEXOID_CARD="prod_test"
STRIPE_PRICE_ID_NEXOID_CARD="price_test"
STRIPE_PRODUCT_ID_APOIE_NEXOID="prod_test"
STRIPE_PRICE_ID_APOIE_NEXOID="price_test"
