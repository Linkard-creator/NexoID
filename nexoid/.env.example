# NexoID local development template
# Copy to .env.local and fill in real values before starting the app.
#
# IMPORTANT:
# - PUBLIC variables are safe to use in frontend and public pages.
# - ADMIN/INTERNAL variables are secret and must not be exposed to common users.
# - Do not mix public values with admin values in the same context.

# ==========================================================
# PUBLIC / FRONTEND SAFE
# These values may be exposed to the public website and browser.
# ==========================================================
NEXT_PUBLIC_APP_URL="http://localhost:8080"
NEXT_PUBLIC_GOOGLE_ENABLED="false"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ==========================================================
# DATABASE / APP CORE (internal)
# These are required for Prisma, auth and app runtime.
# ==========================================================
POSTGRES_PRISMA_URL="postgresql://postgres:postgres@localhost:5432/nexoid?schema=public"
POSTGRES_URL_NON_POOLING="postgresql://postgres:postgres@localhost:5432/nexoid?schema=public"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nexoid?schema=public"
AUTH_SECRET="replace-with-a-strong-random-secret"
AUTH_TRUST_HOST="true"
AUTH_URL="http://localhost:8080"

# ==========================================================
# ADMIN / INTERNAL CONFIGURATION
# Only the admin account should be allowed to use these features.
# ==========================================================
ADMIN_EMAIL="helive.2024@gmail.com"

# Google OAuth (secret/internal)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Stripe (secret/internal)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRODUCT_ID_NEXOID_CARD=""
STRIPE_PRICE_ID_NEXOID_CARD=""
STRIPE_PRODUCT_ID_APOIE_NEXOID=""
STRIPE_PRICE_ID_APOIE_NEXOID=""
