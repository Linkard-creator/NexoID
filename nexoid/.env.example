# ============================================
# NexoID — Variáveis de Ambiente
# ============================================
# 1. Renomeie este arquivo para .env.local
# 2. Preencha os valores
# 3. Rode: npm install && npx prisma db push && npm run dev
# ============================================

# Banco de dados (SQLite local — não precisa mudar)
DATABASE_URL="file:./dev.db"

# NextAuth (OBRIGATÓRIO)
# Gere um secret forte: openssl rand -base64 32
AUTH_SECRET="COLE_AQUI_UM_SECRET_FORTE_MIN_32_CHARS"
AUTH_URL="http://localhost:3000"

# URL pública da aplicação
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email do administrador (já definido)
ADMIN_EMAIL="helive.2024@gmail.com"

# ============================================
# Google OAuth (opcional no início — necessário para login com Google)
# Console: https://console.cloud.google.com/apis/credentials
# ============================================
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ============================================
# Stripe (necessário para vender o cartão)
# Dashboard: https://dashboard.stripe.com/apikeys
# ============================================
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_NEXOID_CARD=""
