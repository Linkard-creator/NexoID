# ==========================================================
# NEXOID - DEVELOPMENT ENVIRONMENT
# ==========================================================
#
# This file is for developer setup only.
# It follows the same rule as .env.local:
# - PUBLIC values are safe for browser/public pages
# - ADMIN/INTERNAL values are restricted and never exposed to normal users
# - Keep this file out of version control if it contains real secrets
#
# IMPORTANT:
# - Use .env.local for machine-specific overrides
# - Use .env.development for shared developer defaults
# - Keep production variables in Vercel project settings only
#
# ==========================================================
# PUBLIC / FRONTEND SAFE
# ==========================================================
NEXT_PUBLIC_APP_URL="http://localhost:8080"
NEXT_PUBLIC_GOOGLE_ENABLED="false"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_publishable_key_here"

# ==========================================================
# DATABASE / APP CORE
# ==========================================================
POSTGRES_PRISMA_URL="postgresql://postgres:postgres@localhost:5432/nexoid?schema=public"
POSTGRES_URL_NON_POOLING="postgresql://postgres:postgres@localhost:5432/nexoid?schema=public"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nexoid?schema=public"
AUTH_SECRET="replace-with-a-strong-random-secret"
AUTH_TRUST_HOST="true"
AUTH_URL="http://localhost:8080"

# ==========================================================
# ADMIN / INTERNAL
# These must not be exposed in public navigation or marketing pages.
# They are only meant for admin power users and developer setup.
# ==========================================================
ADMIN_EMAIL="helive.2024@gmail.com"

# Google OAuth (secret/internal)
AUTH_GOOGLE_ID="your_google_client_id_here"
AUTH_GOOGLE_SECRET="your_google_client_secret_here"

# Stripe (secret/internal)
STRIPE_SECRET_KEY="sk_test_your_secret_key_here"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret_here"
STRIPE_PRODUCT_ID_NEXOID_CARD="prod_your_product_id_here"
STRIPE_PRICE_ID_NEXOID_CARD="price_your_price_id_here"
STRIPE_PRODUCT_ID_APOIE_NEXOID="prod_support_id_here"
STRIPE_PRICE_ID_APOIE_NEXOID="price_support_id_here"
